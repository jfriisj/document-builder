# ==============================================================================
# Document Builder - Environment Configuration Template
# ==============================================================================
# Copy this file to .env before starting the Docker Compose stack:
#   cp .env.example .env
#
# DO NOT place sensitive credentials or production secrets in this file.
# ==============================================================================

# Domain name for Caddy automatic HTTPS.
# Use 'localhost' for local development/smoke testing (uses Caddy internal TLS).
# Use a fully qualified domain name (e.g. docs.example.com) in production for
# automatic public ACME TLS certificates via Let's Encrypt / ZeroSSL.
DOMAIN=localhost

# Versioned production application image reference.
# In production, specify an explicit versioned image reference (never an unqualified 'latest').
APP_IMAGE=document-builder:0.1.0

# Host port exposure for Caddy reverse proxy.
# Only Caddy publishes host ports. The FastAPI app is never exposed directly to the host.
HTTP_PORT=80
HTTPS_PORT=443
